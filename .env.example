# Next.js app. Local values come from `npm run dev`; hosted values come from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Scripts only (db:seed and demo:reset with --remote). Never set these in Vercel.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Server-only. Only selected providers need credentials.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_REASONING_MODEL=openai:gpt-6-luna
AI_EMBEDDING_MODEL=openai:text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
# Demo account. Seeds the user and powers the "Enter demo workspace" button. Password: 12+ characters.
DEMO_EMAIL=pm@memoba.local
DEMO_PASSWORD=
